# 복사해서 .env 로 사용: cp .env.example .env

NODE_ENV=development

# PostgreSQL
# 앱 런타임 롤(RLS 적용, NOBYPASSRLS)
DATABASE_URL=postgres://wellbuddy_app:wellbuddy_app@localhost:5432/wellbuddy
# 마이그레이션·시드용 소유자 롤
DATABASE_URL_OWNER=postgres://wellbuddy_owner:wellbuddy_owner@localhost:5432/wellbuddy

# Redis (BullMQ 작업 큐)
REDIS_URL=redis://localhost:6379

# 인증 — 운영에서는 반드시 긴 난수로 교체 (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# 필드 암호화 (주민번호·계좌·API 자격증명) — 32바이트 키를 base64로 (openssl rand -base64 32)
FIELD_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
FIELD_ENCRYPTION_KEY_ID=k1

# 서버 주소
API_PORT=4000
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# 파일 저장: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-northeast-2
S3_BUCKET=wellbuddy
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# 메일: SMTP_HOST 를 비워두면 발송 대신 로그로 출력
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WellBuddy <no-reply@wellbuddy.local>"

# 작업 큐: true 이면 워커 없이 요청 안에서 바로 실행(개발 편의). 운영은 false + 워커 실행
#   pnpm --filter @wellbuddy/api worker
QUEUE_INLINE=true
