{
  "name": "@wellbuddy/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WellBuddy ERP API 서버 (NestJS) + BullMQ 워커",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "openapi": "node --enable-source-maps dist/openapi-export.js ../../packages/api-client/openapi.json",
    "seed": "pnpm --filter @wellbuddy/db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.1",
    "@nestjs/core": "^12.1.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@wellbuddy/db": "workspace:*",
    "@wellbuddy/shared": "workspace:*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.12",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.1",
    "@swc/core": "^1.16.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.4",
    "supertest": "^7.3.0",
    "unplugin-swc": "^2.0.0"
  }
}
